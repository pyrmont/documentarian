{:name "documentarian"
 :version "DEVEL"
 :description "Generate documentation from Janet and C source files"
 :author "Michael Camilleri"
 :license "MIT"
 :url "https://github.com/pyrmont/documentation"
 :repo "git+https://github.com/pyrmont/documentation"

 :vendored [{:name "argy-bargy"
             :url "https://github.com/pyrmont/argy-bargy"
             :prefix "deps/argy-bargy"
             :paths ["argy-bargy.janet"
                     "LICENSE"]}
            {:name "musty"
             :url "https://github.com/pyrmont/musty"
             :prefix "deps/musty"
             :paths ["lib/musty.janet"
                     "init.janet"
                     "LICENSE"]}
            {:name "testament"
             :url "https://github.com/pyrmont/testament"
             :prefix "deps/testament"
             :paths ["lib/testament.janet"
                     "init.janet"
                     "LICENSE"]}]

 :artifacts {:libraries [{:prefix "documentarian"
                          :paths ["deps"
                                  "lib"
                                  "init.janet"]}]
             :scripts [{:path "bin/documentarian"}]}}
